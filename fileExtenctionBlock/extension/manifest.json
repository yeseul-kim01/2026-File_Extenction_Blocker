{
  "manifest_version": 3,
  "name": "File Extension Blocker",
  "version": "0.1.0",
  "description": "Tenant policy 기반 파일 업로드 확장자 차단",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],

  "options_page": "options.html",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
